# Copy this template to `agent/shelterwise_agent/.env` before running `adk web` or `adk run`:
#   cp agent/.env.example agent/shelterwise_agent/.env
#
# One-time Cloud Shell OAuth / ADC & BigQuery MCP setup:
#   export PROJECT_ID="your-gcp-project-id"
#   gcloud config set project "$PROJECT_ID"
#   gcloud auth application-default login --scopes="https://www.googleapis.com/auth/cloud-platform"
#   gcloud auth application-default set-quota-project "$PROJECT_ID"
#   gcloud beta services mcp enable bigquery.googleapis.com --project="$PROJECT_ID"

# --- ADK / Vertex AI Gemini Auth (uses Google ADC OAuth token; no API key required) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- BigQuery & Vertex AI Vector Search Connection ---
A4I_DATASET=a4i_housing
A4I_LOCATION=US
A4I_VERTEX_CONNECTION=us.a4i-vertex
A4I_EMBEDDING_MODEL=gemini-embedding-2
A4I_COMPLAINTS_EMBEDDED_TABLE=complaints_embedded
A4I_TRACT_VIEW=v_tract_stability_context

# --- ShelterWise Runtime Settings ---
SHELTERWISE_METRO=San Francisco
# "auto" uses BigQuery when GOOGLE_CLOUD_PROJECT is set; set "fixture" for offline tests
SHELTERWISE_BACKEND=auto
SHELTERWISE_MODEL=gemini-2.5-flash
SHELTERWISE_COORDINATOR_MODEL=gemini-2.5-pro
# Set to "true" only if you want to disable remote BigQuery MCP toolset
SHELTERWISE_DISABLE_BQ_MCP=false
