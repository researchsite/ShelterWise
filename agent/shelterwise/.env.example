# Copy to agent/shelterwise/.env (git-ignored). `adk web` loads it automatically.

# --- Gemini via Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini model region (check model availability; us-central1 is the safe default)
GOOGLE_CLOUD_LOCATION=us-central1

# --- Data ---
# bigquery = real AI.EMBED + VECTOR_SEARCH (use for the demo)
# local    = repo parquet + keyword stand-in (offline dev/tests only)
SHELTERWISE_DATA=bigquery
A4I_DATASET=a4i_housing
A4I_LOCATION=US
A4I_VERTEX_CONNECTION=us.a4i-vertex
A4I_EMBED_ENDPOINT=gemini-embedding-2

# --- Models ---
SHELTERWISE_MODEL_FAST=gemini-2.5-flash
SHELTERWISE_MODEL_STRONG=gemini-2.5-pro

# --- Optional ---
SHELTERWISE_ENABLE_MCP=true
# GOOGLE_MAPS_API_KEY=
# Pin the intake date for a repeatable demo:
# SHELTERWISE_TODAY=2026-11-19
